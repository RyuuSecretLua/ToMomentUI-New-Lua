	TabBtn.TextSize = 11
	TabBtn.ZIndex = 5
	MakeCorner(TabBtn, 5)

	local TabIndicator = Instance.new("Frame", TabBtn)
	TabIndicator.Size = UDim2.new(1, 0, 0, 2)
	TabIndicator.Position = UDim2.new(0, 0, 1, -2)
	TabIndicator.BackgroundColor3 = THEME.AccentGreen
	TabIndicator.BorderSizePixel = 0
	TabIndicator.Visible = false
	TabIndicator.ZIndex = 6
	MakeCorner(TabIndicator, 2)
	AnimateColor(TabIndicator, "BackgroundColor3")

	local TabFrame = Instance.new("ScrollingFrame", self.ContentArea)
	TabFrame.Size = UDim2.new(1, 0, 1, 0)
	TabFrame.BackgroundTransparency = 1
	TabFrame.BorderSizePixel = 0
	TabFrame.ScrollBarThickness = 3
	TabFrame.ScrollBarImageColor3 = THEME.AccentCyan
	TabFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
	TabFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
	TabFrame.Visible = false

	local FrameList = Instance.new("UIListLayout", TabFrame)
	FrameList.Padding = UDim.new(0, 8)
	FrameList.HorizontalAlignment = Enum.HorizontalAlignment.Center
	FrameList.SortOrder = Enum.SortOrder.LayoutOrder

	local FramePad = Instance.new("UIPadding", TabFrame)
	FramePad.PaddingTop = UDim.new(0, 10)
	FramePad.PaddingBottom = UDim.new(0, 10)

	tabData.Button = TabBtn
	tabData.Frame = TabFrame
	tabData.Indicator = TabIndicator
	tabData._order = 0

	local function SelectTab()
		for _, td in pairs(self._tabs) do
			td.Frame.Visible = false
			td.Indicator.Visible = false
			TweenService:Create(td.Button, TweenInfo.new(0.2), {BackgroundTransparency = 0.5, TextColor3 = THEME.TextDim}):Play()
		end
		TabFrame.Visible = true
		TabIndicator.Visible = true
		TweenService:Create(TabBtn, TweenInfo.new(0.2), {BackgroundTransparency = 0.2, TextColor3 = THEME.Text}):Play()
		self._activeTab = tabData
	end

	TabBtn.MouseButton1Click:Connect(SelectTab)
	table.insert(self._tabs, tabData)
	if #self._tabs == 1 then SelectTab() end

	function tabData:AddSection(sectionName)
		local sectionData = {}
		local order = tabData._order
		tabData._order = tabData._order + 1

		local SectionLabel = Instance.new("TextLabel", TabFrame)
		SectionLabel.LayoutOrder = order
		SectionLabel.Size = UDim2.new(0, 390, 0, 20)
		SectionLabel.BackgroundTransparency = 1
		SectionLabel.Text = sectionName and ("  " .. sectionName:upper()) or ""
		SectionLabel.TextColor3 = THEME.AccentCyan
		SectionLabel.Font = Enum.Font.GothamBold
		SectionLabel.TextSize = 10
		SectionLabel.TextXAlignment = Enum.TextXAlignment.Left

		local SectionFrame = Instance.new("Frame", TabFrame)
		SectionFrame.LayoutOrder = order + 1
		SectionFrame.Size = UDim2.new(0, 390, 0, 0)
		SectionFrame.BackgroundColor3 = THEME.Surface
		SectionFrame.AutomaticSize = Enum.AutomaticSize.Y
		MakeCorner(SectionFrame, 8)
		MakeStroke(SectionFrame, 1.5)

		local SectionList = Instance.new("UIListLayout", SectionFrame)
		SectionList.Padding = UDim.new(0, 0)
		SectionList.SortOrder = Enum.SortOrder.LayoutOrder

		sectionData._frame = SectionFrame
		sectionData._order = 0
		tabData._order = tabData._order + 2

		local function NextOrder()
			local o = sectionData._order
			sectionData._order = sectionData._order + 1
			return o
		end

		local function MakeItemFrame()
			local f = Instance.new("Frame", SectionFrame)
			f.LayoutOrder = NextOrder()
			f.Size = UDim2.new(1, 0, 0, 44)
			f.BackgroundTransparency = 1
			f.BorderSizePixel = 0
			local sep = Instance.new("Frame", f)
			sep.Size = UDim2.new(1, -20, 0, 1)
			sep.Position = UDim2.new(0, 10, 1, -1)
			sep.BackgroundColor3 = Color3.fromRGB(30, 30, 42)
			sep.BorderSizePixel = 0
			return f
		end

		function sectionData:AddButton(btnName, callback)
			local ItemFrame = MakeItemFrame()
			ItemFrame.Size = UDim2.new(1, 0, 0, 46)

			local Btn = Instance.new("TextButton", ItemFrame)
			Btn.Size = UDim2.new(1, -20, 0, 30)
			Btn.Position = UDim2.new(0, 10, 0.5, -15)
			Btn.BackgroundColor3 = Color3.fromRGB(0, 40, 28)
			Btn.Text = btnName
			Btn.TextColor3 = THEME.AccentGreen
			Btn.Font = Enum.Font.GothamBold
			Btn.TextSize = 12
			MakeCorner(Btn, 6)
			MakeStroke(Btn, 1.5)

			Btn.MouseButton1Click:Connect(function()
				TweenService:Create(Btn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(0, 80, 50)}):Play()
				task.wait(0.15)
				TweenService:Create(Btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(0, 40, 28)}):Play()
				if callback then pcall(callback) end
			end)

			return Btn
		end

		function sectionData:AddToggle(toggleName, default, callback)
			local ItemFrame = MakeItemFrame()
			local state = default or false

			MakeLabel(ItemFrame, {
				text = toggleName, size = 12,
				uiSize = UDim2.new(1, -70, 1, 0),
				pos = UDim2.new(0, 14, 0, 0),
				color = THEME.Text,
			})

			local ToggleBg = Instance.new("Frame", ItemFrame)
			ToggleBg.Size = UDim2.new(0, 44, 0, 22)
			ToggleBg.Position = UDim2.new(1, -58, 0.5, -11)
			ToggleBg.BackgroundColor3 = state and THEME.ToggleOn or THEME.ToggleOff
			MakeCorner(ToggleBg, 11)

			local ToggleKnob = Instance.new("Frame", ToggleBg)
			ToggleKnob.Size = UDim2.new(0, 16, 0, 16)
			ToggleKnob.Position = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
			ToggleKnob.BackgroundColor3 = Color3.new(1, 1, 1)
			MakeCorner(ToggleKnob, 8)

			local ToggleBtn = Instance.new("TextButton", ItemFrame)
			ToggleBtn.Size = UDim2.new(1, 0, 1, 0)
			ToggleBtn.BackgroundTransparency = 1
			ToggleBtn.Text = ""

			local toggleData = {Value = state}

			local function SetState(newState)
				state = newState
				toggleData.Value = state
				TweenService:Create(ToggleBg, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {
					BackgroundColor3 = state and THEME.ToggleOn or THEME.ToggleOff
				}):Play()
				TweenService:Create(ToggleKnob, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {
					Position = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
				}):Play()
				if callback then pcall(callback, state) end
			end

			ToggleBtn.MouseButton1Click:Connect(function() SetState(not state) end)
			toggleData.Set = SetState
			return toggleData
		end

		function sectionData:AddSlider(sliderName, options, callback)
			local ItemFrame = MakeItemFrame()
			ItemFrame.Size = UDim2.new(1, 0, 0, 60)

			local min = options.Min or 0
			local max = options.Max or 100
			local default = options.Default or min
			local suffix = options.Suffix or ""

			MakeLabel(ItemFrame, {
				text = sliderName, size = 12,
				uiSize = UDim2.new(0.6, 0, 0, 20),
				pos = UDim2.new(0, 14, 0, 6),
				color = THEME.Text,
			})

			local ValueLabel = MakeLabel(ItemFrame, {
				text = tostring(default) .. suffix, size = 11,
				uiSize = UDim2.new(0.4, -14, 0, 20),
				pos = UDim2.new(0.6, 0, 0, 6),
				color = THEME.AccentCyan,
				xAlign = Enum.TextXAlignment.Right,
			})

			local Track = Instance.new("Frame", ItemFrame)
			Track.Size = UDim2.new(1, -28, 0, 6)
			Track.Position = UDim2.new(0, 14, 0, 36)
			Track.BackgroundColor3 = Color3.fromRGB(30, 30, 46)
			MakeCorner(Track, 3)

			local Fill = Instance.new("Frame", Track)
			Fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
			Fill.BackgroundColor3 = THEME.AccentGreen
			MakeCorner(Fill, 3)
			AnimateColor(Fill, "BackgroundColor3")

			local Knob = Instance.new("Frame", Track)
			Knob.Size = UDim2.new(0, 14, 0, 14)
			local kp = (default - min) / (max - min)
			Knob.Position = UDim2.new(kp, -7, 0.5, -7)
			Knob.BackgroundColor3 = Color3.new(1, 1, 1)
			MakeCorner(Knob, 7)
			MakeStroke(Knob, 1)

			local sliderData = {Value = default}
			local dragging = false

			local function UpdateSlider(inputX)
				local relX = math.clamp((inputX - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
				local value = math.floor(min + relX * (max - min) + 0.5)
				local perc = (value - min) / (max - min)
				Fill.Size = UDim2.new(perc, 0, 1, 0)
				Knob.Position = UDim2.new(perc, -7, 0.5, -7)
				ValueLabel.Text = tostring(value) .. suffix
				sliderData.Value = value
				if callback then pcall(callback, value) end
			end

			Knob.InputBegan:Connect(function(i)
				if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
					dragging = true
				end
			end)

			Track.InputBegan:Connect(function(i)
				if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
					dragging = true
					UpdateSlider(i.Position.X)
				end
			end)

			UserInputService.InputChanged:Connect(function(i)
				if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
					UpdateSlider(i.Position.X)
				end
			end)

			UserInputService.InputEnded:Connect(function(i)
				if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
					dragging = false
				end
			end)

			sliderData.Set = function(v)
				local perc = math.clamp((v - min) / (max - min), 0, 1)
				Fill.Size = UDim2.new(perc, 0, 1, 0)
				Knob.Position = UDim2.new(perc, -7, 0.5, -7)
				ValueLabel.Text = tostring(v) .. suffix
				sliderData.Value = v
			end

			return sliderData
		end

		function sectionData:AddSelect(selectName, options, callback)
			local ItemFrame = MakeItemFrame()
			ItemFrame.Size = UDim2.new(1, 0, 0, 46)
			local selected = options[1] or ""

			MakeLabel(ItemFrame, {
				text = selectName, size = 12,
				uiSize = UDim2.new(0.5, 0, 1, 0),
				pos = UDim2.new(0, 14, 0, 0),
				color = THEME.Text,
			})

			local SelBtn = Instance.new("TextButton", ItemFrame)
			SelBtn.Size = UDim2.new(0.45, -4, 0, 28)
			SelBtn.Position = UDim2.new(0.55, 0, 0.5, -14)
			SelBtn.BackgroundColor3 = THEME.SurfaceAlt
			SelBtn.Text = selected .. "  ▾"
			SelBtn.TextColor3 = THEME.AccentCyan
			SelBtn.Font = Enum.Font.GothamSemibold
			SelBtn.TextSize = 11
			MakeCorner(SelBtn, 5)
			MakeStroke(SelBtn, 1.2)

			local DropFrame = Instance.new("Frame", ItemFrame)
			DropFrame.Size = UDim2.new(0.45, -4, 0, #options * 28)
			DropFrame.Position = UDim2.new(0.55, 0, 0, 46)
			DropFrame.BackgroundColor3 = THEME.Surface
			DropFrame.Visible = false
			DropFrame.ZIndex = 20
			MakeCorner(DropFrame, 5)
			MakeStroke(DropFrame, 1.2)

			local DropList2 = Instance.new("UIListLayout", DropFrame)
			DropList2.SortOrder = Enum.SortOrder.LayoutOrder

			for i, opt in ipairs(options) do
				local OptBtn = Instance.new("TextButton", DropFrame)
				OptBtn.LayoutOrder = i
				OptBtn.Size = UDim2.new(1, 0, 0, 28)
				OptBtn.BackgroundTransparency = 1
				OptBtn.Text = opt
				OptBtn.TextColor3 = THEME.Text
				OptBtn.Font = Enum.Font.GothamSemibold
				OptBtn.TextSize = 11
				OptBtn.ZIndex = 21

				OptBtn.MouseButton1Click:Connect(function()
					selected = opt
					SelBtn.Text = selected .. "  ▾"
					SelBtn.TextColor3 = THEME.AccentGreen
					DropFrame.Visible = false
					if callback then pcall(callback, selected) end
				end)

				OptBtn.MouseEnter:Connect(function()
					OptBtn.BackgroundColor3 = THEME.AccentGreen
					TweenService:Create(OptBtn, TweenInfo.new(0.1), {BackgroundTransparency = 0.6}):Play()
				end)
				OptBtn.MouseLeave:Connect(function()
					TweenService:Create(OptBtn, TweenInfo.new(0.15), {BackgroundTransparency = 1}):Play()
				end)
			end

			SelBtn.MouseButton1Click:Connect(function()
				DropFrame.Visible = not DropFrame.Visible
			end)

			local selectData = {
				Value = selected,
				Set = function(v) selected = v SelBtn.Text = v .. "  ▾" end,
				Get = function() return selected end,
			}
			return selectData
		end

		function sectionData:AddSelectToggle(stName, options, callback)
			local ItemFrame = MakeItemFrame()
			local rowCount = math.ceil(#options / 3)
			ItemFrame.Size = UDim2.new(1, 0, 0, 24 + rowCount * 32)

			MakeLabel(ItemFrame, {
				text = stName, size = 11,
				uiSize = UDim2.new(1, -20, 0, 18),
				pos = UDim2.new(0, 14, 0, 4),
				color = THEME.TextDim,
			})

			local PillContainer = Instance.new("Frame", ItemFrame)
			PillContainer.Size = UDim2.new(1, -28, 0, rowCount * 32)
			PillContainer.Position = UDim2.new(0, 14, 0, 24)
			PillContainer.BackgroundTransparency = 1

			local PillGrid = Instance.new("UIGridLayout", PillContainer)
			PillGrid.CellSize = UDim2.new(0, 112, 0, 26)
			PillGrid.CellPadding = UDim2.new(0, 6, 0, 4)
			PillGrid.SortOrder = Enum.SortOrder.LayoutOrder

			local active = {}
			local pillBtns = {}

			for i, opt in ipairs(options) do
				active[opt] = false
				local Pill = Instance.new("TextButton", PillContainer)
				Pill.LayoutOrder = i
				Pill.BackgroundColor3 = THEME.SurfaceAlt
				Pill.Text = opt
				Pill.TextColor3 = THEME.TextDim
				Pill.Font = Enum.Font.GothamSemibold
				Pill.TextSize = 10
				MakeCorner(Pill, 13)

				local pillStroke = Instance.new("UIStroke", Pill)
				pillStroke.Thickness = 1
				pillStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
				pillStroke.Color = THEME.SurfaceAlt

				pillBtns[opt] = {btn = Pill, stroke = pillStroke}

				Pill.MouseButton1Click:Connect(function()
					active[opt] = not active[opt]
					if active[opt] then
						TweenService:Create(Pill, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(0, 40, 28), TextColor3 = THEME.AccentGreen}):Play()
						AnimateBorder(pillStroke)
					else
						TweenService:Create(Pill, TweenInfo.new(0.15), {BackgroundColor3 = THEME.SurfaceAlt, TextColor3 = THEME.TextDim}):Play()
						pillStroke.Color = THEME.SurfaceAlt
					end
					if callback then pcall(callback, opt, active[opt], active) end
				end)
			end

			return {
				GetActive = function() return active end,
				Set = function(opt, val)
					if active[opt] ~= nil then
						active[opt] = val
						local pData = pillBtns[opt]
						if pData then
							if val then
								pData.btn.BackgroundColor3 = Color3.fromRGB(0, 40, 28)
								pData.btn.TextColor3 = THEME.AccentGreen
								AnimateBorder(pData.stroke)
							else
								pData.btn.BackgroundColor3 = THEME.SurfaceAlt
								pData.btn.TextColor3 = THEME.TextDim
								pData.stroke.Color = THEME.SurfaceAlt
							end
						end
					end
				end,
			}
		end

		return sectionData
	end

	return tabData
end

return ToMomentUI
