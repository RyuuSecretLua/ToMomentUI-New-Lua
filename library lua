
local ToMomentUI = {}
ToMomentUI.__index = ToMomentUI

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local ACCENT = Color3.fromRGB(0, 180, 120)

local function AnimateBorder(stroke)
	local hue = 0
	task.spawn(function()
		while stroke and stroke.Parent do
			hue = (hue + 0.008) % 1
			local r, g, b = Color3.fromHSV(hue * 0.18 + 0.45, 1, 1):components()
			stroke.Color = Color3.new(r, g, b)
			task.wait()
		end
	end)
end

local function MakeStroke(parent, thickness)
	local s = Instance.new("UIStroke", parent)
	s.Thickness = thickness or 2
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Color = ACCENT
	AnimateBorder(s)
	return s
end

local function MakeCorner(parent, radius)
	Instance.new("UICorner", parent).CornerRadius = UDim.new(0, radius or 6)
end

