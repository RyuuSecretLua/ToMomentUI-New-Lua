local ToMomentUI = {}
ToMomentUI.__index = ToMomentUI

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local function AnimateBorder(stroke)
	local t = 0
	task.spawn(function()
		while stroke and stroke.Parent do
			t = t + 0.012
			local r = 0.55 + math.sin(t) * 0.1
			stroke.Color = Color3.fromHSV(r, 0.35, 1)
			task.wait()
		end
	end)
end

local function MakeStroke(parent, thickness)
	local s = Instance.new("UIStroke", parent)
	s.Thickness = thickness or 2
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Color = Color3.fromRGB(160, 220, 255)
	AnimateBorder(s)
	return s
end

local function MakeCorner(parent, radius)
	Instance.new("UICorner", parent).CornerRadius = UDim.new(0, radius or 6)
end

