local ToMomentUI = {}
ToMomentUI.__index = ToMomentUI

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local GRADIENT_COLORS = {
	Color3.fromRGB(0, 255, 120),
	Color3.fromRGB(0, 220, 180),
	Color3.fromRGB(0, 160, 255),
	Color3.fromRGB(0, 220, 180),
	Color3.fromRGB(0, 255, 120),
}

local THEME = {
	Background  = Color3.fromRGB(8, 8, 12),
	Surface     = Color3.fromRGB(14, 14, 20),
	SurfaceAlt  = Color3.fromRGB(18, 18, 26),
	Text        = Color3.fromRGB(230, 230, 240),
	TextDim     = Color3.fromRGB(140, 140, 160),
	AccentGreen = Color3.fromRGB(0, 255, 120),
	AccentBlue  = Color3.fromRGB(0, 160, 255),
	AccentCyan  = Color3.fromRGB(0, 220, 180),
	ToggleOn    = Color3.fromRGB(0, 200, 100),
	ToggleOff   = Color3.fromRGB(50, 50, 65),
}

local function AnimateBorder(stroke)
	local idx = 1
	task.spawn(function()
		while stroke and stroke.Parent do
			idx = (idx % #GRADIENT_COLORS) + 1
			TweenService:Create(stroke, TweenInfo.new(0.8, Enum.EasingStyle.Sine), {Color = GRADIENT_COLORS[idx]}):Play()
			task.wait(0.8)
		end
	end)
end

local function AnimateColor(obj, prop)
	local idx = 1
	task.spawn(function()
		while obj and obj.Parent do
			idx = (idx % #GRADIENT_COLORS) + 1
			local t = {}
			t[prop] = GRADIENT_COLORS[idx]
			TweenService:Create(obj, TweenInfo.new(0.8, Enum.EasingStyle.Sine), t):Play()
			task.wait(0.8)
		end
	end)
end

local function MakeStroke(parent, thickness)
	local s = Instance.new("UIStroke", parent)
	s.Thickness = thickness or 1.5
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Color = THEME.AccentGreen
	AnimateBorder(s)
	return s
end

local function MakeCorner(parent, radius)
	local c = Instance.new("UICorner", parent)
	c.CornerRadius = UDim.new(0, radius or 6)
	return c
end

local function MakeLabel(parent, props)
	local l = Instance.new("TextLabel", parent)
	l.BackgroundTransparency = 1
	l.TextColor3 = props.color or THEME.Text
	l.Font = props.font or Enum.Font.GothamSemibold
	l.TextSize = props.size or 12
	l.Text = props.text or ""
	l.TextXAlignment = props.xAlign or Enum.TextXAlignment.Left
	l.TextYAlignment = props.yAlign or Enum.TextYAlignment.Center
	if props.uiSize then l.Size = props.uiSize end
	if props.pos then l.Position = props.pos end
	return l
end

