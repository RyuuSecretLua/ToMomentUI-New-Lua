function ToMomentUI:AddTab(name)
	local tabData = {}

	local TabBtn = Instance.new("TextButton", self.TabBar)
	TabBtn.Size = UDim2.new(0, 50, 1, 0)
	TabBtn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	TabBtn.BackgroundTransparency = 0.7
	TabBtn.Text = name
	TabBtn.TextColor3 = Color3.new(0.5, 0.5, 0.5)
	TabBtn.Font = Enum.Font.GothamBold
	TabBtn.TextSize = 10
	TabBtn.ZIndex = 3
	MakeCorner(TabBtn, 4)

	local TabFrame = Instance.new("ScrollingFrame", self.Container)
	TabFrame.Size = UDim2.new(1, 0, 1, 0)
	TabFrame.BackgroundTransparency = 1
	TabFrame.BorderSizePixel = 0
	TabFrame.ScrollBarThickness = 2
	TabFrame.ScrollBarImageColor3 = Color3.fromRGB(160, 220, 255)
	TabFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
	TabFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
	TabFrame.Visible = false
	TabFrame.ZIndex = 3

	local UIList = Instance.new("UIListLayout", TabFrame)
	UIList.Padding = UDim.new(0, 6)
	UIList.HorizontalAlignment = Enum.HorizontalAlignment.Center
	UIList.SortOrder = Enum.SortOrder.LayoutOrder

	local UIPad = Instance.new("UIPadding", TabFrame)
	UIPad.PaddingTop = UDim.new(0, 4)
	UIPad.PaddingBottom = UDim.new(0, 8)

	tabData.Button = TabBtn
	tabData.Frame = TabFrame
	tabData._order = 0

	local function SelectTab()
		for _, td in pairs(self._tabs) do
			td.Frame.Visible = false
			td.Button.TextColor3 = Color3.new(0.5, 0.5, 0.5)
			td.Button.BackgroundTransparency = 0.7
		end
		TabFrame.Visible = true
		TabBtn.TextColor3 = Color3.fromRGB(160, 220, 255)
		TabBtn.BackgroundTransparency = 0.4
	end

	TabBtn.MouseButton1Click:Connect(SelectTab)
	table.insert(self._tabs, tabData)
	if #self._tabs == 1 then SelectTab() end

	local screenGuiRef = self.ScreenGui

	function tabData:AddWidget(widget)
		widget.LayoutOrder = tabData._order
		tabData._order = tabData._order + 1
		widget.Parent = TabFrame
	end

	function tabData:AddButton(labelText, callback)
		local Btn = Instance.new("TextButton")
		Btn.Size = UDim2.new(0, 155, 0, 30)
		Btn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		Btn.BackgroundTransparency = 0.7
		Btn.Text = labelText
		Btn.TextColor3 = Color3.new(1, 1, 1)
		Btn.Font = Enum.Font.GothamBold
		Btn.TextSize = 11
		Btn.ZIndex = 4
		MakeCorner(Btn, 4)
		MakeStroke(Btn, 2)
		tabData:AddWidget(Btn)
		Btn.MouseButton1Click:Connect(function() if callback then pcall(callback) end end)
		return Btn
	end

	function tabData:AddToggle(labelText, default, callback)
		local state = default or false
		local Btn = Instance.new("TextButton")
		Btn.Size = UDim2.new(0, 155, 0, 30)
		Btn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		Btn.BackgroundTransparency = 0.7
		Btn.Text = labelText .. ": " .. (state and "ON" or "OFF")
		Btn.TextColor3 = state and Color3.fromRGB(160, 220, 255) or Color3.new(1, 1, 1)
		Btn.Font = Enum.Font.GothamBold
		Btn.TextSize = 11
		Btn.ZIndex = 4
		MakeCorner(Btn, 4)
		MakeStroke(Btn, 2)
		tabData:AddWidget(Btn)

		local toggleData = {Value = state}

		local function SetState(newState)
			state = newState
			toggleData.Value = state
			Btn.Text = labelText .. ": " .. (state and "ON" or "OFF")
			Btn.TextColor3 = state and Color3.fromRGB(160, 220, 255) or Color3.new(1, 1, 1)
			if callback then pcall(callback, state) end
		end

		Btn.MouseButton1Click:Connect(function() SetState(not state) end)
		toggleData.Set = SetState
		return toggleData
	end

	function tabData:AddSlider(labelText, options, callback)
		local min = options.Min or 0
		local max = options.Max or 100
		local default = options.Default or min
		local suffix = options.Suffix or ""

		local Holder = Instance.new("Frame")
		Holder.Size = UDim2.new(0, 155, 0, 46)
		Holder.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		Holder.BackgroundTransparency = 0.7
		Holder.ZIndex = 4
		MakeCorner(Holder, 4)
		MakeStroke(Holder, 2)
		tabData:AddWidget(Holder)

		local NameLabel = Instance.new("TextLabel", Holder)
		NameLabel.Size = UDim2.new(0.6, 0, 0, 20)
		NameLabel.Position = UDim2.new(0, 7, 0, 2)
		NameLabel.BackgroundTransparency = 1
		NameLabel.Text = labelText
		NameLabel.TextColor3 = Color3.new(1, 1, 1)
		NameLabel.Font = Enum.Font.GothamBold
		NameLabel.TextSize = 11
		NameLabel.TextXAlignment = Enum.TextXAlignment.Left
		NameLabel.ZIndex = 5

		local ValLabel = Instance.new("TextLabel", Holder)
		ValLabel.Size = UDim2.new(0.4, -7, 0, 20)
		ValLabel.Position = UDim2.new(0.6, 0, 0, 2)
		ValLabel.BackgroundTransparency = 1
		ValLabel.Text = tostring(default) .. suffix
		ValLabel.TextColor3 = Color3.fromRGB(160, 220, 255)
		ValLabel.Font = Enum.Font.GothamBold
		ValLabel.TextSize = 11
		ValLabel.TextXAlignment = Enum.TextXAlignment.Right
		ValLabel.ZIndex = 5

		local Track = Instance.new("Frame", Holder)
		Track.Size = UDim2.new(1, -14, 0, 6)
		Track.Position = UDim2.new(0, 7, 0, 32)
		Track.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
		Track.ZIndex = 5
		MakeCorner(Track, 3)

		local Fill = Instance.new("Frame", Track)
		Fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
		Fill.BackgroundColor3 = Color3.fromRGB(160, 220, 255)
		Fill.ZIndex = 6
		MakeCorner(Fill, 3)

		local sliderData = {Value = default}
		local dragging = false

		local function Update(inputX)
			local relX = math.clamp((inputX - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
			local value = math.floor(min + relX * (max - min) + 0.5)
			Fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
			ValLabel.Text = tostring(value) .. suffix
			sliderData.Value = value
			if callback then pcall(callback, value) end
		end

		Track.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				Update(i.Position.X)
			end
		end)

		UserInputService.InputChanged:Connect(function(i)
			if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
				Update(i.Position.X)
			end
		end)

		UserInputService.InputEnded:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
				dragging = false
			end
		end)

		sliderData.Set = function(v)
			Fill.Size = UDim2.new(math.clamp((v - min) / (max - min), 0, 1), 0, 1, 0)
			ValLabel.Text = tostring(v) .. suffix
			sliderData.Value = v
		end

		return sliderData
	end

	function tabData:AddInput(placeholder, callback)
		local Box = Instance.new("TextBox")
		Box.Size = UDim2.new(0, 155, 0, 26)
		Box.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		Box.BackgroundTransparency = 0.7
		Box.TextColor3 = Color3.new(1, 1, 1)
		Box.PlaceholderText = placeholder or ""
		Box.PlaceholderColor3 = Color3.fromRGB(120, 120, 120)
		Box.Font = Enum.Font.GothamSemibold
		Box.TextSize = 11
		Box.Text = ""
		Box.ClearTextOnFocus = false
		Box.ZIndex = 4
		MakeCorner(Box, 4)
		MakeStroke(Box, 2)
		tabData:AddWidget(Box)

		local inputData = {
			Value = "",
			Set = function(v) Box.Text = v end,
			Get = function() return Box.Text end,
		}

		Box.FocusLost:Connect(function(enter)
			inputData.Value = Box.Text
			if callback then pcall(callback, Box.Text, enter) end
		end)

		return inputData
	end

	function tabData:AddSelect(options, callback)
		local selected = options[1] or ""

		local SelBtn = Instance.new("TextButton")
		SelBtn.Size = UDim2.new(0, 155, 0, 30)
		SelBtn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		SelBtn.BackgroundTransparency = 0.7
		SelBtn.Text = selected .. " ▼"
		SelBtn.TextColor3 = Color3.new(1, 1, 1)
		SelBtn.Font = Enum.Font.GothamBold
		SelBtn.TextSize = 11
		SelBtn.ZIndex = 4
		MakeCorner(SelBtn, 4)
		MakeStroke(SelBtn, 2)
		tabData:AddWidget(SelBtn)

		local DropFrame = Instance.new("Frame", screenGuiRef)
		DropFrame.Size = UDim2.new(0, 155, 0, math.min(#options * 26, 130))
		DropFrame.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
		DropFrame.Visible = false
		DropFrame.ZIndex = 50
		MakeCorner(DropFrame, 4)
		MakeStroke(DropFrame, 2)

		local DropScroll = Instance.new("ScrollingFrame", DropFrame)
		DropScroll.Size = UDim2.new(1, 0, 1, 0)
		DropScroll.BackgroundTransparency = 1
		DropScroll.BorderSizePixel = 0
		DropScroll.ScrollBarThickness = 2
		DropScroll.ScrollBarImageColor3 = Color3.fromRGB(160, 220, 255)
		DropScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
		DropScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
		DropScroll.ZIndex = 51

		local DropList = Instance.new("UIListLayout", DropScroll)
		DropList.SortOrder = Enum.SortOrder.LayoutOrder

		for i, opt in ipairs(options) do
			local b = Instance.new("TextButton", DropScroll)
			b.LayoutOrder = i
			b.Size = UDim2.new(1, 0, 0, 26)
			b.BackgroundTransparency = 1
			b.Text = opt
			b.TextColor3 = Color3.new(1, 1, 1)
			b.Font = Enum.Font.GothamSemibold
			b.TextSize = 11
			b.ZIndex = 52
			b.MouseButton1Click:Connect(function()
				selected = opt
				SelBtn.Text = selected .. " ▼"
				SelBtn.TextColor3 = Color3.fromRGB(160, 220, 255)
				DropFrame.Visible = false
				if callback then pcall(callback, selected) end
			end)
		end

		SelBtn.MouseButton1Click:Connect(function()
			if DropFrame.Visible then
				DropFrame.Visible = false
				return
			end
			local absPos = SelBtn.AbsolutePosition
			local absSize = SelBtn.AbsoluteSize
			DropFrame.Position = UDim2.new(0, absPos.X, 0, absPos.Y + absSize.Y + 2)
			DropFrame.Visible = true
		end)

		UserInputService.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 then
				local mp = UserInputService:GetMouseLocation()
				local dp = DropFrame.AbsolutePosition
				local ds = DropFrame.AbsoluteSize
				if DropFrame.Visible and not (mp.X >= dp.X and mp.X <= dp.X + ds.X and mp.Y >= dp.Y and mp.Y <= dp.Y + ds.Y) then
					DropFrame.Visible = false
				end
			end
		end)

		local selectData = {
			Value = selected,
			Set = function(v) selected = v SelBtn.Text = v .. " ▼" end,
			Get = function() return selected end,
		}
		return selectData
	end

	function tabData:AddLabel(text)
		local Label = Instance.new("TextLabel")
		Label.Size = UDim2.new(0, 155, 0, 18)
		Label.BackgroundTransparency = 1
		Label.Text = text
		Label.TextColor3 = Color3.fromRGB(160, 220, 255)
		Label.Font = Enum.Font.GothamBold
		Label.TextSize = 10
		Label.TextXAlignment = Enum.TextXAlignment.Left
		Label.ZIndex = 4
		tabData:AddWidget(Label)
		return Label
	end

	return tabData
end

return ToMomentUI
